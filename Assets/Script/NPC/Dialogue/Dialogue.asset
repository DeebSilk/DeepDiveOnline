  m_Script: {fileID: 11500000, guid: 4b35bdcaf3156c64489af2145debc7d3, type: 3}
  m_Name: Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  npcName: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A"
  lines:
  - speaker: 
    text: "\u0421\u0430\u043B\u0430\u043C \u0410\u0410\u043B\u0435\u0439\u043A\u0443\u0443\u0443\u0443\u0443\u043C
      \u044D\u044D\u044D \u043D\u0430\u0445, \u043A\u0435\u043C \u0431\u0443\u0434\u0435\u0448\u044C,
      \u043B\u0430\u043D \u043F\u043E\u0445\u0435\u0440,"
    choices:
    - text: "\u043E\u043A\u0435\u0439"
      nextIndex: 2
    - text: "\u0443\u0439\u0442\u0438"
      nextIndex: -1
  - speaker: 
    text: "\u043F\u0438\u0434\u0430\u0440\u0430\u0441"
    choices: []
  - speaker: 
    text: "\u0432 \u043C\u043E\u0451\u043C \u0434\u043E\u0431\u044B \u0431\u044B\u043B
      \u043A\u0438\u043D\u0436\u0430\u043B, \u0437\u0430\u0431\u0438\u0440\u0430\u0439
      \u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0437\u0431\u0430\u0432\u0441\u044F
      \u043E\u0442 \u0431\u043E\u043C\u0436\u0435\u0439"
    choices:
    - text: "\u0445\u043E\u0440\u043E\u0448\u043E"
      nextIndex: 3
    - text: "\u0434\u0430\u0443\u043D"
      nextIndex: -1
  - speaker: 
    text: "\u044F \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043C\u0438\u043D\u0435\u0442\u0447\u0438\u043A"
    choices:
    - text: "\u043E\u043A"
      nextIndex: -1
